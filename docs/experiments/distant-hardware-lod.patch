diff --git a/tools/detail-geometry-check.mjs b/tools/detail-geometry-check.mjs
new file mode 100644
index 0000000..57e4bf0
--- /dev/null
+++ b/tools/detail-geometry-check.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import * as T from 'three';
+import {writeFileSync} from 'node:fs';
+import {doorIronworkGeometry} from '../src/joinery.js';
+import {pipeBracketGeometry} from '../src/rainware.js';
+import {meshTopology} from './structure/geom.mjs';
+
+// Measure both directions, including face interiors and edge midpoints. The
+// configured bound is conservative; this regression measures actual solids.
+const triangles=g=>{
+  const p=g.attributes.position,ix=g.index,n=ix?.count??p.count,out=[];
+  for(let i=0;i<n;i+=3)out.push(new T.Triangle(...[0,1,2].map(k=>new T.Vector3().fromBufferAttribute(p,ix?ix.getX(i+k):i+k))));
+  return out;
+};
+const distance=(source,target)=>{
+  let maximum=0,samples=0;const point=new T.Vector3(),closest=new T.Vector3();
+  for(const t of source)for(const [a,b,c]of [[1,0,0],[0,1,0],[0,0,1],[.5,.5,0],[0,.5,.5],[.5,0,.5],[1/3,1/3,1/3]]) {
+    point.copy(t.a).multiplyScalar(a).addScaledVector(t.b,b).addScaledVector(t.c,c);
+    let best=Infinity;
+    for(const u of target){u.closestPointToPoint(point,closest);best=Math.min(best,point.distanceToSquared(closest));}
+    maximum=Math.max(maximum,Math.sqrt(best));samples++;
+  }
+  return {maximum,samples};
+};
+const rows=[];
+for(const [name,build,bound]of [['door ironwork',doorIronworkGeometry,.006],['pipe bracket',pipeBracketGeometry,.0071]]) {
+  const full=build(),far=build({distant:true}),topology=meshTopology(far);
+  assert.equal(topology.boundaryEdges,0,name+' open surface');assert.equal(topology.nonManifoldEdges,0,name+' invalid join');
+  assert.equal(topology.flippedEdges,0,name+' winding');assert(topology.volume>0,name+' solid volume');
+  const f=triangles(full),d=triangles(far),outward=distance(f,d),inward=distance(d,f);
+  assert(Math.max(outward.maximum,inward.maximum)<=bound,name+' exceeds the projected-error bound');
+  rows.push({name,fullTriangles:f.length,distantTriangles:d.length,bound,fullToDistant:outward,distantToFull:inward,
+    topology:{boundary:topology.boundaryEdges,nonmanifold:topology.nonManifoldEdges,flipped:topology.flippedEdges,volume:topology.volume}});
+}
+writeFileSync('shots/rendercheck/detail-20260926-geometry.json',JSON.stringify(rows,null,2)+'\n');
+console.log(JSON.stringify(rows));
diff --git a/tools/detail-lod-capture.mjs b/tools/detail-lod-capture.mjs
