index 0000000..592492c
--- /dev/null
+++ b/tools/detail-lod-capture.mjs
@@ -0,0 +1,79 @@
+import {readFileSync,writeFileSync} from 'node:fs';
+import {pngPixels} from './png-pixels.mjs';
+
+export async function detailLODChecks(page,{name,dir,rows,errors,args}) {
+  const option=(key,fallback)=>args.includes(key)?args[args.indexOf(key)+1]:fallback;
+  const dpr=Number(option('--detail-dpr',1));
+  await page.setViewport({width:1600,height:1000,deviceScaleFactor:dpr});
+  await page.goto('http://localhost:8765/?shot=1&hud=0&time=12.87',{waitUntil:'domcontentloaded'});
+  await page.waitForFunction('window.__READY&&window.__captureFrame',{timeout:90000});
+  const stations=[],times=[];
+  for(const raw of readFileSync('tools/campaign.txt','utf8').split('\n')) {
+    const m=raw.replace(/\s+#.*$/,'').trim().match(/^(view|time)\s+(\S+)\s+(.+)$/);
+    if(!m)continue;
+    if(m[1]==='time')times.push({label:m[2],time:Number(m[3])});
+    else {
+      const [x,z,yaw,pitch,extra]=m[3].split(':'),query=new URLSearchParams(extra);
+      stations.push({id:m[2],x:+x,z:+z,yaw:+yaw,pitch:+pitch,gy:query.has('gy')?+query.get('gy'):undefined,fov:+query.get('fov')||60});
+    }
+  }
+  const close=JSON.parse(readFileSync('docs/september-rainware-views.json','utf8')).map(s=>({...s,close:true}));
+  const cases=[...stations.flatMap(s=>times.map(t=>({...s,...t}))),...close.map(s=>({...s,label:'close',time:12.87}))];
+  for(const s of args.includes('--detail-benchmark-only')?[]:args.includes('--quick')?cases.filter(s=>s.id==='v3_roofs'||s.id==='v2_alley'||s.id==='pipe-63'):cases) {
+    await page.evaluate(s=>{
+      const w=window.__world,p=w.player;p.teleport(s.x,s.z,s.yaw,s.pitch);
+      if(s.gy!==undefined){const g=p.floorAt(s.x,s.z,s.gy);p.groundY=p.smoothY=g.y;p.zone=g.zone;}
+      p.bobAmp=0;p.frozen=true;w.camera.fov=s.fov;w.camera.updateProjectionMatrix();w.worldState.time=s.time;
+    },s);
+    const snapshots=[];
+    for(const enabled of [false,true,false]) {
+      const shot=await page.evaluate(async enabled=>{
+        const w=window.__world;w.instanceLOD.geometricDetailEnabled=enabled;
+        let png,frames=0;do{png=await window.__captureFrame();frames++;}while(frames<3||w.lighting.environment.pending);
+        return {png,stats:{...window.__RENDER_STATS},gpuError:w.renderer.getContext().getError(),
+          tiers:w.instanceLOD.batches.filter(b=>b.farMesh).map(b=>({name:b.mesh.name,capacity:b.capacity,near:b.mesh.count,far:b.farMesh.count,
+            ids:[...b.ids.subarray(0,b.mesh.count),...b.farIds.subarray(0,b.farMesh.count)].sort((a,b)=>a-b)}))};
+      },enabled);
+      snapshots.push({...shot,png:Buffer.from(shot.png.split(',')[1],'base64')});
+    }
+    const [full,candidate,restored]=snapshots;
+    const a=pngPixels(full.png),b=pngPixels(candidate.png);let peak=0,total=0,changed=0;
+    for(let i=0;i<a.width*a.height;i++){
+      let pixel=0;for(let c=0;c<3;c++){const delta=Math.abs(a.pixels[i*a.channels+c]-b.pixels[i*b.channels+c]);peak=Math.max(peak,delta);pixel=Math.max(pixel,delta);total+=delta;}
+      changed+=pixel>0;
+    }
+    const sameIDs=JSON.stringify(full.tiers.map(t=>t.ids))===JSON.stringify(candidate.tiers.map(t=>t.ids));
+    const row={id:s.id,time:s.time,close:!!s.close,full:full.stats,candidate:candidate.stats,sameIDs,
+      restored:full.png.equals(restored.png),maxByteError:peak,meanByteError:total/(a.width*a.height*3),changedPixels:changed,
+      tiers:candidate.tiers.map(({ids,...t})=>t),gpuErrors:snapshots.map(s=>s.gpuError)};
+    for(const [label,shot]of [['full',full],['detail',candidate]])writeFileSync(new URL(`${name}-${s.id}-${s.label}-${label}.png`,dir),shot.png);
+    rows.push({view:'detail-lod',...row});console.log(JSON.stringify(row));
+    if(!sameIDs||!row.restored||row.gpuErrors.some(Boolean)||candidate.stats.drawCalls>200)errors.push('Detail LOD state or budget mismatch: '+s.id);
+    if(row.meanByteError>.01||(s.close&&row.changedPixels))errors.push('Visible detail LOD change requires inspection: '+s.id);
+  }
+  // Paired runs in the same process isolate this change from power state,
+  // browser warm-up and other applications. Both runs advance the normal clock.
+  if(args.includes('--detail-benchmark')) {
+    const station=stations.find(s=>s.id==='v3_roofs');
+    const samples=await page.evaluate(async ({s,times})=>{
+      const w=window.__world,p=w.player;p.teleport(s.x,s.z,s.yaw,s.pitch);
+      const g=p.floorAt(s.x,s.z,s.gy);p.groundY=p.smoothY=g.y;p.zone=g.zone;
+      w.camera.fov=s.fov;w.camera.updateProjectionMatrix();const frame=()=>new Promise(resolve=>requestAnimationFrame(resolve)),out=[];
+      const update=w.instanceLOD.update;let lodMS=0;
+      w.instanceLOD.update=function(...args){const start=performance.now();try{return update.apply(this,args);}finally{lodMS+=performance.now()-start;}};
+      try { for(const time of times)for(const enabled of [false,true,true,false,false,true]) {
+        w.instanceLOD.geometricDetailEnabled=enabled;w.worldState.time=time;
+        for(let i=0;i<45;i++)await frame();let previous=performance.now(),lastDelta=1/60;const ms=[],calls=[];
+        lodMS=0;
+        for(let i=0;i<150;i++){
+          w.worldState.time+=Math.min(lastDelta,.05)*36/3600;await frame();const now=performance.now();
+          ms.push(now-previous);calls.push(window.__RENDER_STATS.drawCalls);lastDelta=(now-previous)/1000;previous=now;
+        }
+        out.push({time,enabled,fps:150000/ms.reduce((a,b)=>a+b),maxCalls:Math.max(...calls),lodMS:lodMS/150,ms});
+      } } finally { w.instanceLOD.update=update; }
+      return out;
+    },{s:station,times:option('--detail-times','12.87,19.65').split(',').map(Number)});
+    rows.push({view:'detail-benchmark',samples});console.log(JSON.stringify({benchmark:samples.map(({ms,...s})=>s)}));
+  }
+  writeFileSync(new URL(name+'-detail.json',dir),JSON.stringify(rows,null,2)+'\n');
+}
